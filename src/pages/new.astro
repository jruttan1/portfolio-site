---
import BaseLayout from "../layouts/BaseLayout.astro";
import MusicWidget from "../components/MusicWidget.astro";
import ChessWidget from "../components/toys/ChessWidget.astro";
import LineSidebar from "../components/new/LineSidebar.astro";
import ResearchVisual from "../components/new/ResearchVisual.astro";
import { profile } from "../data/profile";

const navItems = [
  { label: "About", target: "top" },
  { label: "Projects", target: "projects" },
  { label: "Research", target: "research" }
];
const projectVideos = ["/optimate-demo-1758064916274.mp4", "/doppels-demo.mp4"];
---

<BaseLayout title="Jack Ruttan — AI Systems, Product, and Research">
  <main class="portfolio-new">
    <div class="site-grid">
      <aside class="side-nav">
        <div class="side-nav-stack">
          <LineSidebar items={navItems} />
          <div class="side-music">
            <MusicWidget />
          </div>
        </div>
      </aside>

      <div class="content">
        <div id="top" class="top-anchor section-anchor">
          <header class="site-header">
            <h1>Jack Ruttan</h1>
          </header>

          <section class="overview" aria-labelledby="about-heading">
            <div class="about-details">
              <div class="about-copy">
                <h2 id="about-heading">About</h2>
                <p>I’m a computer science and mathematics student at Western University interested in applied AI, product engineering, and research.</p>
                <p>Right now, I’m building internal AI systems at Lifemark Health Group and working on Primate, my visual QA startup.</p>
                <p class="location">{profile.location} · {profile.availability}</p>
              </div>

              <div class="experience">
                <h2>Experience</h2>
                <ol>
                  {profile.experience.map((role) => (
                    <li>
                      <div class="role-copy">
                        <div class="role-heading">
                          {role.logo === "red-cross" ? (
                            <span class="employer-logo employer-logo-cross" aria-hidden="true">
                              <svg viewBox="0 0 16 16">
                                <path d="M6.2 1.8h3.6v4.4h4.4v3.6H9.8v4.4H6.2V9.8H1.8V6.2h4.4z" fill="currentColor" />
                              </svg>
                            </span>
                          ) : (
                            <img class="employer-logo" src={role.logo} alt="" loading="lazy" decoding="async" aria-hidden="true" />
                          )}
                          <h3><a href={role.url} target="_blank" rel="noopener noreferrer">{role.name}</a></h3>
                        </div>
                        <p class="role-title">{role.role}</p>
                      </div>
                      <span class="period">{role.period}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>

            <div class="chess-feature">
              <ChessWidget />
              <div class="chess-copy">
                <p>A transformer based reinforcement learning chess bot, is currently training. It'll be playable soon!</p>
                <a href="https://github.com/jruttan1/KaspaRLov/tree/main" target="_blank" rel="noopener noreferrer">Follow its training on GitHub</a>
              </div>
            </div>
          </section>
        </div>

        <section id="projects" class="section section-anchor" aria-label="Projects">

          <article class="project project-featured">
            <video class="project-visual primate-video" autoplay muted loop playsinline preload="metadata" poster="/primate.svg">
              <source src="/primate-demo-vid.mp4" type="video/mp4" />
            </video>
            <div class="project-info">
              <div class="project-summary">
                <h3>{profile.projects[0].name}</h3>
                <p>{profile.projects[0].description}. Visual QA for teams shipping web products.</p>
                <a class="project-site" href={profile.projects[0].url} target="_blank" rel="noopener noreferrer">
                  <img class="project-logo project-logo-primate" src="/primate-logo.png" alt="" aria-hidden="true" />
                  <span>primate.sh</span>
                </a>
              </div>
            </div>
          </article>

          <div class="project-grid">
            {profile.projects.slice(1).map((project, index) => (
              <article class="project">
                <a class="project-video-link" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name}`}>
                  <video class="project-visual project-demo" autoplay muted loop playsinline preload="metadata" aria-label={`${project.name} product demo`}>
                    <source src={projectVideos[index]} type="video/mp4" />
                  </video>
                </a>
                <div class="project-info project-info-small">
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  {project.prizes?.map((prize) => (
                    <div class="project-prize">
                      <img class="hackathon-logo" src={prize.logo} alt="" loading="lazy" decoding="async" aria-hidden="true" />
                      <small><strong>{prize.name}</strong> · {prize.note}</small>
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="research" class="section section-anchor" aria-label="Research">
          <div class="research-layout">
            <ResearchVisual />
            <article class="publication">
              <div class="publication-copy">
                <p class="publication-venue">AmericasNLP · Association for Computational Linguistics</p>
                <h3>{profile.research[0].title}</h3>
                <p class="publication-authors">
                  Jesus Alvarez C, Daua Karajeanes, Ashley Prado, <strong>John Ruttan</strong>, Ivory Yang, Sean O’Brien, Vasu Sharma, and Kevin Zhu
                </p>
                <p class="publication-summary">{profile.research[0].description}.</p>
                <nav class="publication-links" aria-label="Publication links">
                  <a href={profile.research[0].url} target="_blank" rel="noopener noreferrer">Paper</a>
                  <a href={profile.research[0].pdf} target="_blank" rel="noopener noreferrer">PDF</a>
                  <a href={profile.research[0].doi} target="_blank" rel="noopener noreferrer">DOI</a>
                </nav>
              </div>
            </article>
          </div>
        </section>

        <footer>
          <p>© Jack Ruttan 2026</p>
          <nav aria-label="Contact links">
            {profile.contact.map((item) => (
              <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}>{item.label}</a>
            ))}
          </nav>
        </footer>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f6f4ef; }
  .portfolio-new, .portfolio-new * { box-sizing: border-box; }
  .portfolio-new {
    --ink: #171715;
    --muted: #73726c;
    --accent: #d9482b;
    min-height: 100vh;
    background: #f6f4ef;
    color: var(--ink);
  }
  .site-grid {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 48px;
    width: min(100% - 64px, 1680px);
    margin: 0 auto;
  }
  .side-nav { padding-top: 43px; }
  .side-nav-stack { position: sticky; top: 36px; }
  .side-music { margin-top: 28px; padding-top: 8px; }
  .side-music :global(.widget-music > div) { width: 120px; max-width: 120px; }
  .side-music :global(.widget-music [data-play]) { width: 4.25rem; }
  .side-music :global(.widget-music .flex.h-4.w-44) { width: 120px; }
  .content { min-width: 0; }
  .top-anchor { scroll-margin-top: 0; }
  .section-anchor { scroll-margin-top: 40px; }
  .site-header { padding: 36px 0 52px; }
  .site-header h1 { margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -.025em; line-height: 1; }
  .overview { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr); gap: clamp(48px, 5vw, 84px); align-items: start; }
  .about-details { min-width: 0; }
  .overview h2, .section > h2 { margin: 0 0 26px; color: var(--muted); font-family: inherit; font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .about-copy > p { max-width: 620px; margin: 0 0 21px; font-size: 18px; letter-spacing: -.012em; line-height: 1.55; }
  .about-copy .location { margin-top: 34px; color: var(--muted); font-size: 13px; line-height: 1.4; }
  .experience ol { display: grid; gap: 27px; margin: 0; padding: 0; list-style: none; }
  .experience li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; }
  .period { max-width: 120px; padding-top: 3px; color: var(--muted); font: 10px/1.45 var(--font-mono); text-align: right; text-transform: uppercase; }
  .role-heading { display: flex; align-items: center; gap: 9px; min-width: 0; }
  .employer-logo { width: 18px; height: 18px; flex: 0 0 18px; object-fit: contain; opacity: .82; }
  .employer-logo-cross { display: grid; color: #b91c1c; place-items: center; }
  .employer-logo-cross svg { display: block; width: 16px; height: 16px; }
  .role-copy h3 { margin: 0; font-size: 15px; font-weight: 650; line-height: 1.25; }
  .role-copy h3 a { color: inherit; text-decoration: none; }
  .role-copy h3 a:hover { color: var(--accent); }
  .role-title { margin: 4px 0 0; color: var(--muted); font-size: 13px; line-height: 1.4; }
  .experience { margin-top: 64px; }
  .chess-feature { width: 100%; min-width: 0; }
  .chess-feature :global(.widget-chess) { width: min(100%, 36rem); }
  .chess-feature :global(.chessground-board.cg-wrap) { width: 100%; height: auto; }
  .chess-copy { width: min(100%, 21rem); margin-top: 18px; }
  .chess-copy p { max-width: 420px; margin: 0 0 11px; color: var(--muted); font-size: 13px; line-height: 1.55; }
  .chess-copy a, .project-info a, .publication-links a { color: var(--ink); font-size: 12px; font-weight: 600; text-underline-offset: 4px; }
  .chess-copy a:hover, .project-info a:hover, .publication-links a:hover { color: var(--accent); }
  .section { margin-right: clamp(30px, 4vw, 60px); padding: 108px 0 24px; }
  .section > h2 { margin-bottom: 32px; }
  .project { min-width: 0; }
  .project-visual { display: grid; width: 100%; overflow: hidden; background: #e5e2da; place-items: center; }
  .primate-video { aspect-ratio: 16 / 8.7; object-fit: cover; }
  .project-info { display: grid; grid-template-columns: 150px minmax(0, 1fr) auto; gap: 24px; align-items: baseline; padding-top: 18px; }
  .project-info h3 { margin: 0; font-size: 20px; font-weight: 600; letter-spacing: -.02em; line-height: 1.2; }
  .project-featured .project-info { grid-template-columns: 1fr; }
  .project-summary p { max-width: 620px; margin: 7px 0 0; font-size: 14px; line-height: 1.55; }
  .project-site { display: inline-flex; width: fit-content; align-items: center; gap: 9px; margin-top: 13px; }
  .project-logo { width: 18px; height: 18px; flex: 0 0 18px; object-fit: contain; }
  .project-logo-primate { width: 26px; height: 26px; flex-basis: 26px; border-radius: 4px; }
  .project-info > p { max-width: 620px; margin: 0; font-size: 14px; line-height: 1.55; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 48px; }
  .project-video-link { display: block; color: var(--ink); text-decoration: none; }
  .project-grid .project-visual { min-height: 0; aspect-ratio: 16 / 10; object-fit: cover; }
  .project-info-small { grid-template-columns: 1fr; gap: 8px; }
  .project-info-small h3 { font-size: 18px; }
  .project-prize { display: flex; align-items: center; gap: 8px; margin-top: 5px; }
  .hackathon-logo { width: 19px; height: 19px; flex: 0 0 19px; object-fit: contain; opacity: .82; }
  .project-info-small small { color: var(--muted); font-size: 11px; line-height: 1.45; }
  .project-info-small small strong { color: var(--ink); font-weight: 600; }
  .research-layout { display: grid; grid-template-columns: minmax(440px, 1.12fr) minmax(360px, .88fr); gap: clamp(38px, 4vw, 64px); align-items: stretch; }
  .publication { display: block; padding: 4px 0 28px; }
  .publication-copy { display: flex; height: 100%; min-width: 0; flex-direction: column; }
  .publication-venue { margin: 0 0 14px; color: var(--muted); font-size: 12px; }
  .publication h3 { max-width: 680px; margin: 0; font-size: clamp(22px, 2.4vw, 30px); font-weight: 550; letter-spacing: -.035em; line-height: 1.17; }
  .publication-authors { max-width: 730px; margin: 18px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
  .publication-authors strong { color: var(--ink); font-weight: 600; }
  .publication-summary { max-width: 500px; margin: 22px 0 0; font-size: 14px; line-height: 1.65; }
  .publication-links { display: flex; gap: 20px; margin-top: auto; padding-top: 28px; }
  footer { display: flex; justify-content: space-between; gap: 32px; margin-right: clamp(30px, 4vw, 60px); padding: 120px 0 48px; color: var(--muted); font-size: 12px; }
  footer p { margin: 0; }
  footer nav { display: flex; gap: 24px; }
  footer a { color: var(--ink); text-decoration: none; }
  footer a:hover { color: var(--accent); }

  @media (max-width: 1050px) {
    .site-grid { grid-template-columns: 92px minmax(0, 1fr); gap: 40px; width: min(100% - 48px, 1120px); }
    .overview { grid-template-columns: 1fr; gap: 52px; }
    .chess-feature :global(.widget-chess) { width: min(100%, 20rem); }
    .project-info { grid-template-columns: 120px 1fr; }
    .project-info > a { grid-column: 2; }
    .research-layout { grid-template-columns: 1fr; gap: 42px; }
    .research-layout > :global(.research-visual) { max-width: 500px; }
  }

  @media (max-width: 720px) {
    .site-grid { display: block; width: calc(100% - 32px); }
    .side-nav { display: none; }
    .site-header { padding: 26px 0 42px; }
    .site-header h1 { font-size: 24px; }
    .overview { gap: 44px; }
    .about-copy > p { font-size: 17px; }
    .experience li { grid-template-columns: minmax(0, 1fr) auto; gap: 16px; }
    .experience { margin-top: 52px; }
    .chess-feature :global(.widget-chess) { width: min(100%, 18rem); }
    .section { margin-right: 0; padding-top: 84px; }
    .project-info { grid-template-columns: 1fr; gap: 8px; }
    .project-featured .project-info { grid-template-columns: 1fr; align-items: start; }
    .project-info > a { grid-column: auto; }
    .project-grid { grid-template-columns: 1fr; gap: 54px; margin-top: 58px; }
    .project-grid .project-visual { min-height: 0; }
    .research-layout { grid-template-columns: 1fr; gap: 42px; }
    .publication { padding-top: 0; }
    .publication h3 { font-size: 25px; }
    footer { margin-right: 0; padding-top: 88px; }
  }

  @media (min-width: 721px) and (max-height: 820px) {
    .chess-feature :global(.widget-chess) { width: min(100%, 20rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .primate-video { display: none; }
  }
</style>
