---
import { ArrowLeft, ArrowRight, ArrowUpRight } from "lucide-static";
interface Props {
  direction?: "left" | "right" | "up-right";
  class?: string;
}
const { direction = "up-right", class: className = "" } = Astro.props;
const icons = { left: ArrowLeft, right: ArrowRight, "up-right": ArrowUpRight };
---
<span class:list={["arrow-icon", className]} aria-hidden="true" set:html={icons[direction]} />
<style>
  .arrow-icon { display: inline-flex; width: 16px; height: 16px; flex: 0 0 auto; vertical-align: middle; }
  .arrow-icon :global(svg) { width: 100%; height: 100%; stroke-width: 1.75; }
</style>
