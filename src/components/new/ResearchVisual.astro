<figure class="research-visual" aria-labelledby="research-visual-title">
  <div class="visual-inner">

    <div class="stage stage-teach">
      <span class="step">01</span>
      <div class="stage-copy">
        <strong>Give an LLM trusted examples</strong>
        <small>80 human-verified Comanche ↔ English translation pairs</small>
      </div>
      <div class="example-dots" aria-hidden="true">
        {Array.from({ length: 20 }).map(() => <i></i>)}
      </div>
    </div>

    <div class="connector" aria-hidden="true"><i></i></div>

    <div class="stage stage-generate">
      <span class="step">02</span>
      <div class="stage-copy">
        <strong>Generate held-out translations</strong>
        <small>The model translates 20 phrases it did not see in the examples</small>
      </div>
      <div class="model-flow" aria-hidden="true">
        <span class="model">LLM</span>
        <span class="flow-line"><i></i></span>
        <span class="candidate">generated translation</span>
      </div>
    </div>

    <div class="connector connector-to-compare" aria-hidden="true"><i></i></div>

    <div class="stage stage-compare">
      <span class="step">03</span>
      <div class="stage-copy">
        <strong>Check each generated translation</strong>
        <small>Compare it with the real translation using the Levenshtein similarity algorithm</small>
      </div>

      <div class="comparison" aria-hidden="true">
        <div class="comparison-row">
          <span>model</span>
          <div>{Array.from({ length: 10 }).map((_, index) => <i class:list={{ mismatch: index === 3 || index === 8 }}></i>)}</div>
        </div>
        <div class="comparison-row">
          <span>human</span>
          <div>{Array.from({ length: 10 }).map(() => <i></i>)}</div>
        </div>
      </div>

      <div class="decision">
        <span>Similarity ≥ minimum threshold</span>
        <span class="decision-arrow" aria-hidden="true">→</span>
        <strong>keep</strong>
      </div>
    </div>
  </div>
</figure>

<style>
  .research-visual { margin: 0; overflow: hidden; border-radius: 10px; }
  .visual-inner { height: 100%; padding: clamp(20px, 2.4vw, 26px); border-radius: inherit; background: #e9e6de; }
  h3 { max-width: 430px; margin: 0 0 27px; font-size: 17px; font-weight: 600; letter-spacing: -.02em; line-height: 1.25; }
  .stage { position: relative; display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 10px; }
  .step { padding-top: 2px; color: rgba(23, 23, 21, .42); font: 9px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .stage-copy { min-width: 0; }
  .stage-copy strong { display: block; font-size: 12px; font-weight: 600; line-height: 1.3; }
  .stage-copy small { display: block; max-width: 330px; margin-top: 3px; color: rgba(23, 23, 21, .58); font-size: 10px; line-height: 1.4; }
  .example-dots { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(10, 4px); gap: 5px; margin: 2px 0 3px 34px; }
  .example-dots i { width: 4px; height: 4px; border-radius: 50%; background: rgba(23, 23, 21, .38); animation: example-pulse 2.4s ease-in-out infinite; }
  .example-dots i:nth-child(3n) { animation-delay: .2s; }
  .example-dots i:nth-child(4n) { animation-delay: .45s; }
  .connector { position: relative; width: 1px; height: 13px; margin: 5px 0 5px 45px; overflow: hidden; background: rgba(23, 23, 21, .16); }
  .connector-to-compare { margin-left: clamp(190px, 42%, 220px); }
  .connector i { position: absolute; top: -5px; left: -2px; width: 5px; height: 5px; border-radius: 50%; background: #d9482b; animation: travel-down 2.4s ease-in-out infinite; }
  .model-flow { grid-column: 1 / -1; display: flex; align-items: center; gap: 7px; margin: 9px 0 0 34px; }
  .model, .candidate { display: grid; min-height: 25px; padding: 0 8px; place-items: center; border-radius: 999px; font-size: 9px; font-weight: 600; white-space: nowrap; }
  .model { color: #fff; background: #171715; }
  .candidate { color: rgba(23, 23, 21, .68); background: rgba(255, 255, 255, .55); }
  .flow-line { position: relative; width: clamp(24px, 5vw, 52px); height: 1px; overflow: hidden; background: rgba(23, 23, 21, .2); }
  .flow-line i { position: absolute; top: -2px; left: -5px; width: 5px; height: 5px; border-radius: 50%; background: #d9482b; animation: travel-right 2.4s ease-in-out infinite; }
  .comparison { grid-column: 1 / -1; display: grid; gap: 5px; margin: 10px 0 0 34px; }
  .comparison-row { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 8px; align-items: center; }
  .comparison-row > span { color: rgba(23, 23, 21, .48); font: 9px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; }
  .comparison-row > div { display: flex; gap: 3px; }
  .comparison-row i { display: block; width: clamp(8px, 1.4vw, 11px); height: clamp(8px, 1.4vw, 11px); background: rgba(23, 23, 21, .3); }
  .comparison-row i.mismatch { background: rgba(217, 72, 43, .68); animation: mismatch-pulse 2.4s ease-in-out infinite; }
  .decision { grid-column: 1 / -1; display: grid; grid-template-columns: auto auto auto; align-items: center; justify-content: start; gap: 7px; margin: 10px 0 0 34px; padding-top: 8px; border-top: 1px solid rgba(23, 23, 21, .12); color: rgba(23, 23, 21, .62); font: 9px/1.35 ui-sans-serif, system-ui, sans-serif; white-space: nowrap; }
  .decision-arrow { color: rgba(23, 23, 21, .42); font-size: 14px; line-height: 1; }
  .decision strong { color: #d9482b; font: 600 11px ui-sans-serif, system-ui, sans-serif; text-transform: uppercase; }
  figcaption { padding-top: 10px; color: rgba(23, 23, 21, .58); font-size: 11px; line-height: 1.45; }

  @keyframes travel-down { 0%, 20% { transform: translateY(0); opacity: 0; } 35% { opacity: 1; } 75% { opacity: 1; } 90%, 100% { transform: translateY(33px); opacity: 0; } }
  @keyframes travel-right { 0%, 20% { transform: translateX(0); opacity: 0; } 35% { opacity: 1; } 75% { opacity: 1; } 90%, 100% { transform: translateX(58px); opacity: 0; } }
  @keyframes example-pulse { 0%, 100% { opacity: .45; } 45%, 65% { opacity: 1; background: #d9482b; } }
  @keyframes mismatch-pulse { 0%, 35%, 100% { opacity: .45; } 55%, 75% { opacity: 1; } }

  @media (max-width: 420px) {
    .visual-inner { padding: 22px 18px; }
    .example-dots, .model-flow, .comparison, .decision { margin-left: 30px; }
    .connector { margin-left: 41px; }
    .connector-to-compare { margin-left: min(200px, calc(100% - 22px)); }
    .decision { gap: 7px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-visual * { animation: none !important; }
  }
</style>
