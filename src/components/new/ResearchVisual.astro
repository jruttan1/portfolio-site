<figure class="research-visual" aria-labelledby="research-visual-title">
  <div class="visual-inner">

    <div class="stage stage-teach">
      <span class="step">01</span>
      <div class="stage-copy">
        <strong>Give GPT-4o trusted examples</strong>
        <small>80 human-verified Comanche ↔ English translations</small>
      </div>
      <div class="example-dots" aria-hidden="true">
        {Array.from({ length: 20 }).map(() => <i></i>)}
      </div>
    </div>

    <div class="connector" aria-hidden="true"><i></i></div>

    <div class="stage stage-generate">
      <span class="step">02</span>
      <div class="stage-copy">
        <strong>Generate held-out translations</strong>
        <small>The model translates 20 phrases it did not see in the examples</small>
      </div>
      <div class="model-flow" aria-hidden="true">
        <span class="model">GPT-4o</span>
        <span class="flow-line"><i></i></span>
        <span class="candidate">candidate</span>
      </div>
    </div>

    <div class="connector" aria-hidden="true"><i></i></div>

    <div class="stage stage-compare">
      <span class="step">03</span>
      <div class="stage-copy">
        <strong>Check each generated translation</strong>
        <small>Compare it with the human translation by counting character edits</small>
      </div>

      <div class="comparison" aria-hidden="true">
        <div class="comparison-row">
          <span>model</span>
          <div>{Array.from({ length: 10 }).map((_, index) => <i class:list={{ mismatch: index === 3 || index === 8 }}></i>)}</div>
        </div>
        <div class="comparison-row">
          <span>human</span>
          <div>{Array.from({ length: 10 }).map(() => <i></i>)}</div>
        </div>
      </div>

      <div class="decision">
        <span>Similarity passes the minimum quality threshold</span>
        <strong>keep</strong>
      </div>
    </div>
  </div>
  <figcaption>Normalized Levenshtein similarity is the quality check; only passing translations are kept.</figcaption>
</figure>

