---
interface Item { label: string; target: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

<nav class="line-nav" aria-label="Page sections" data-line-nav>
  <ul>
    {items.map((item, index) => (
      <li class:list={{ active: index === 0 }} data-target={item.target}>
        <span class="marker" aria-hidden="true"></span>
        <a href={`#${item.target}`}>
          <small>{String(index + 1).padStart(2, "0")}</small>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>("[data-line-nav]");
  const items = [...(nav?.querySelectorAll<HTMLElement>("li[data-target]") ?? [])];

  nav?.addEventListener("pointermove", (event) => {
    items.forEach((item) => {
      const rect = item.getBoundingClientRect();
      const distance = Math.abs(event.clientY - (rect.top + rect.height / 2));
      item.style.setProperty("--effect", String(Math.max(0, 1 - distance / 90)));
    });
  });

  nav?.addEventListener("pointerleave", () => items.forEach((item) => item.style.setProperty("--effect", "0")));

  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (!visible) return;
    items.forEach((item) => item.classList.toggle("active", item.dataset.target === visible.target.id));
  }, { rootMargin: "-24% 0px -60%", threshold: [0, 0.2, 0.5] });

  items.forEach((item) => {
    const section = document.getElementById(item.dataset.target ?? "");
    if (section) observer.observe(section);
  });
</script>

<style is:global>
  .line-nav {
    width: max-content;
  }

  .line-nav ul {
    display: flex;
    flex-direction: column;
    gap: 17px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .line-nav li {
    --effect: 0;
    position: relative;
    padding-left: 42px;
  }

  .line-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    color: rgba(20, 20, 18, .42);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    transform: translateX(calc(var(--effect) * 10px));
    transition: color 160ms ease, transform 160ms ease;
  }

  .line-nav small {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
  }

  .line-nav .marker {
    position: absolute;
    top: 50%;
    left: 0;
    width: 32px;
    height: 1px;
    background: rgba(20, 20, 18, .28);
    transform: scaleX(calc(.72 + var(--effect) * .28));
    transform-origin: left;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .line-nav li.active a,
  .line-nav li:hover a,
  .line-nav li:focus-within a {
    color: #d9482b;
    transform: translateX(10px);
  }

  .line-nav li.active .marker,
  .line-nav li:hover .marker,
  .line-nav li:focus-within .marker {
    background: #d9482b;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .line-nav a,
    .line-nav .marker {
      transition: none;
      transform: none;
    }
  }
</style>
