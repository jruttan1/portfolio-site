---
import "@lichess-org/chessground/assets/chessground.base.css";
import "@lichess-org/chessground/assets/chessground.brown.css";
import "@lichess-org/chessground/assets/chessground.cburnett.css";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const initialFen = "r1bqkb1r/pp2pppp/2np1n2/8/3P4/2N2N2/PPP1PPPP/R1BQKB1R";
const roles: Record<string, string> = {
  p: "pawn",
  r: "rook",
  n: "knight",
  b: "bishop",
  q: "queen",
  k: "king"
};
const fallbackPieces = initialFen.split("/").flatMap((rank, rankIndex) => {
  let fileIndex = 0;
  return [...rank].flatMap((symbol) => {
    if (/\d/.test(symbol)) {
      fileIndex += Number(symbol);
      return [];
    }

    const piece = {
      role: roles[symbol.toLowerCase()],
      color: symbol === symbol.toUpperCase() ? "white" : "black",
      x: fileIndex * 100,
      y: rankIndex * 100
    };
    fileIndex += 1;
    return [piece];
  });
});
---

<section class:list={["widget-chess", compact && "widget-chess--compact"]} data-chess-widget>
  <div
    class="chessground-board cg-wrap"
    data-board
    data-fen={initialFen}
    aria-label="Interactive Lichess chess board"
  >
    <cg-container aria-hidden="true">
      <cg-board>
        {fallbackPieces.map((piece) => (
          <piece
            class={`${piece.color} ${piece.role}`}
            style={`transform: translate(${piece.x}%, ${piece.y}%);`}
          ></piece>
        ))}
      </cg-board>
    </cg-container>
  </div>
  <div class="board-footer">
    <span data-chess-status>Move a white piece</span>
    <button type="button" data-board-reset>Reset</button>
  </div>
</section>

<script>
  import { Chessground } from "@lichess-org/chessground";

  document.querySelectorAll<HTMLElement>("[data-chess-widget]").forEach((root) => {
    const board = root.querySelector<HTMLElement>("[data-board]");
    const status = root.querySelector<HTMLElement>("[data-chess-status]");
    const reset = root.querySelector<HTMLButtonElement>("[data-board-reset]");

    if (!board) return;

    const initialFen = board.dataset.fen;
    const ground = Chessground(board, {
      fen: initialFen,
      coordinates: false,
      animation: { enabled: true, duration: 180 },
      movable: {
        color: "white",
        free: true,
        showDests: true,
        events: {
          after: (from, to) => {
            if (status) status.textContent = `${from} → ${to}`;
          }
        }
      }
    });

    reset?.addEventListener("click", () => {
      ground.set({ fen: initialFen });
      if (status) status.textContent = "Move a white piece";
    });
  });
</script>

<style>
  .widget-chess {
    width: 18.5rem;
    max-width: 100%;
  }

  .chessground-board.cg-wrap {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    background: #d8d3c9;
    box-shadow: 0 8px 25px rgba(21, 21, 19, 0.08);
  }

  .board-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 8px;
    color: rgba(21, 21, 19, 0.58);
    font-size: 11px;
  }

  .board-footer button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .board-footer button:hover {
    color: #d9482b;
  }

  .widget-chess--compact {
    width: 11.5rem;
  }

  @media (max-width: 720px) {
    .widget-chess--compact {
      width: 9rem;
    }
  }
</style>
